{
  "name": "actorterm",
  "version": "1.0.0",
  "private": true,
  "description": "ActorTerm static website",
  "scripts": {
    "clean": "node -e \"require('fs').rmSync('dist', { recursive: true, force: true })\"",
    "build:css": "sass --load-path=_sass assets/main.scss dist/assets/main.css --style=compressed --no-source-map",
    "build:site": "eleventy",
    "build": "npm run clean && npm run build:css && npm run build:site",
    "fetch:releases": "node scripts/fetch-releases.mjs",
    "dev": "node scripts/dev.mjs",
    "deploy": "npm run build && npx wrangler deploy -c wrangler.jsonc",
    "deploy:preview": "npm run build && npx wrangler versions upload -c wrangler.jsonc"
  },
  "devDependencies": {
    "@11ty/eleventy": "^3.1.2",
    "sass": "^1.93.2",
    "wrangler": "^4.80.0"
  }
}
